VITE_API_URL=http://localhost:4000/api

# Woontegra kurumsal site Meta Pixel (Bilirkişi Hesap pikseli DEĞİL)
# Production Vercel Variables'da da tanımlayın; yoksa kod varsayılan 351069957242160 kullanır.
VITE_META_PIXEL_ID=351069957242160

# Opsiyonel: statik /images/ yollarını Cloudinary CDN köküne yönlendirir
# VITE_WOONTEGRA_MEDIA_CDN=https://res.cloudinary.com/your-cloud/image/upload/woontegra-static

# Railway’de deploy ettiğiniz backend URL’si (https://xxx.up.railway.app — /api ile bitmez, kök domain)
# VITE_API_URL=https://your-backend.up.railway.app
