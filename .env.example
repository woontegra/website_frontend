# ——— Zorunlu (production) ———
# Railway backend kökü veya /api ile biten tam URL (ikisi de desteklenir)
VITE_API_URL=https://websitebackend-production-ab6e.up.railway.app/api

# ——— Opsiyonel (analytics / pazarlama) ———
# Tracking ID tek kaynak: Admin panel → /api/settings/tracking
# Env yalnızca API boşsa devreye girer (admin değeri her zaman önceliklidir)
# VITE_GA_MEASUREMENT_ID=G-V4R193TJ37
# VITE_GTM_ID=GTM-XXXXXXX
# VITE_GOOGLE_ADS_ID=AW-XXXXXXXXXX
# VITE_META_PIXEL_ID=

# Site URL için ayrı env yok; canonical ve sitemap https://woontegra.com sabitlenmiştir.

# Opsiyonel: statik /images/ yollarını Cloudinary CDN köküne yönlendirir
# VITE_WOONTEGRA_MEDIA_CDN=https://res.cloudinary.com/your-cloud/image/upload/woontegra-static

# ——— Lokal geliştirme ———
# VITE_API_URL=http://localhost:4000/api
