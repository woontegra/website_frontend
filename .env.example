# ——— Zorunlu ———
# Production (Vercel): tam URL veya aynı origin üzerinden /api (vercel.json /api → Railway)
#   VITE_API_URL=https://woontegra.com/api
#   veya VITE_API_URL=/api
#
# Lokal Vite: tarayıcı aynı origin’e istek atsın, CORS olmasın — vite.config proxy /api → aşağıdaki hedef
VITE_API_URL=/api

# Vite dev sunucusunda /api ve /uploads nereye proxylensin (VITE_API_URL=/api iken zorunlu mantıkta).
# Varsayılan: http://127.0.0.1:4000 — yerel backend’i çalıştırın (backend: npm run dev).
# Yerelde Railway API’ye bağlanmak isterseniz (eski davranış):
#   VITE_DEV_API_PROXY=https://websitebackend-production-ab6e.up.railway.app
#
# /uploads varsayılan olarak VITE_DEV_API_PROXY ile aynı hedef (yerel yükleme = yerel önizleme).
# API yerelde, medya dosyaları Railway’deyse:
#   VITE_DEV_UPLOADS_PROXY=https://websitebackend-production-ab6e.up.railway.app
VITE_DEV_API_PROXY=http://127.0.0.1:4000

# Production /uploads görselleri (Vercel rewrite yerine doğrudan backend kökü):
# VITE_BACKEND_PUBLIC_URL=https://websitebackend-production-ab6e.up.railway.app
# VITE_UPLOADS_BASE_URL=https://websitebackend-production-ab6e.up.railway.app
# PayTR mağaza paneli Bildirim URL: https://woontegra.com/api/payments/paytr/callback
# (Vercel vercel.json: /api/* → aynı Railway backend.)
# Admin → Ödeme ayarları Callback URL: yukarıdaki tam adres.
# Başarı / Hata URL: http://localhost:5173/siparis-basarili ve .../siparis-basarisiz (Vite).
#
# Lokal .env için VITE_API_URL=/api kullanın; istekler http://localhost:5173/api/... üzerinden
# Vite proxy ile VITE_DEV_API_PROXY adresine gider (varsayılan yerel :4000).
#
# Alternatif (proxy kullanmadan): doğrudan Railway API kökü
#   VITE_API_URL=https://websitebackend-production-ab6e.up.railway.app/api
#
# Yerel backend ile sadece tamamen lokal PayTR testi (callback da localhost) yapılır.

# ——— Opsiyonel (analytics / pazarlama) ———
# Tracking ID tek kaynak: Admin panel → /api/settings/tracking
# Env yalnızca API boşsa devreye girer (admin değeri her zaman önceliklidir)
# VITE_GA_MEASUREMENT_ID=G-V4R193TJ37
# VITE_GTM_ID=GTM-XXXXXXX
# VITE_GOOGLE_ADS_ID=AW-XXXXXXXXXX
# VITE_META_PIXEL_ID=

# Site URL için ayrı env yok; canonical ve sitemap https://woontegra.com sabitlenmiştir.

# Opsiyonel: statik /images/ yollarını Cloudinary CDN köküne yönlendirir
# VITE_WOONTEGRA_MEDIA_CDN=https://res.cloudinary.com/your-cloud/image/upload/woontegra-static

# ——— Lokal geliştirme (yalnızca yerel backend) ———
# VITE_API_URL=http://localhost:4000/api
